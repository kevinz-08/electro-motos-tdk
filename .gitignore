# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm
.pnpm-store
.pnpm-debug.log*

# turbo
.turbo

# testing
coverage

# next.js
.next/
out/

# nestjs
apps/api/dist/

# production
build
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated via pnpm --filter @h2r/database generate)
packages/database/src/generated/

# compiled JS artifacts that land next to TS source (e.g. from stray tsc runs)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts

# assets de trabajo locales (fotos de productos sin procesar, etc.)
tmp-productos/
apps/web/tmp-productos/

# .md para opencode y claude code
BACKLOG.md*
AUDITORIA.md*

# Playwright
apps/web/playwright/.auth/
apps/web/playwright-report/
apps/web/test-results/
