# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Máximo de conexiones del pool pg.Pool por proceso (default 5).
# En Railway con un solo proceso se puede subir a 10.
# Si usas el pooler nativo de Neon, añade ?pgbouncer=true a DATABASE_URL y baja esto a 1.
DATABASE_POOL_MAX=5

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Wompi ─────────────────────────────────────────────────────────────────────
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=sandbox

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@h2r.co

# ── Imágenes (Cloudinary) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Vendelo (logística / envíos) ─────────────────────────────────────────────
# API Key del panel de Vendelo. Requerida al arrancar el servidor.
VENDELO_API_KEY=
# URL base de la API (sin slash final). Prod: https://api.venndelo.com (doble n)
VENDELO_API_URL=https://api.venndelo.com
# Secret compartido para verificar webhooks entrantes del Chatbot Connection (Fase 3).
VENDELO_WEBHOOK_SECRET=
# Saldo mínimo de wallet (en centavos COP) antes de disparar alerta en logs.
VENDELO_WALLET_ALERT_THRESHOLD=50000

# Información de la tienda para el pickup_info de cada orden Vendelo.
# VENDELO_STORE_CITY_CODE = código DIVIPOLA de 8 dígitos de la ciudad de la tienda.
# Ej: 05001000 = Medellín | 11001000 = Bogotá | 76001000 = Cali
VENDELO_STORE_NAME=Electro Motos TDK
VENDELO_STORE_PHONE=
VENDELO_STORE_ADDRESS=
VENDELO_STORE_CITY_CODE=
VENDELO_STORE_SUBDIVISION_CODE=

# Dimensiones y peso por defecto para todos los productos en line_items.
# Ajustar según el empaque promedio de los repuestos que se despachan.
VENDELO_DEFAULT_WEIGHT_KG=0.5
VENDELO_DEFAULT_HEIGHT_CM=10
VENDELO_DEFAULT_WIDTH_CM=10
VENDELO_DEFAULT_LENGTH_CM=10

# ── Observabilidad (Sentry) ───────────────────────────────────────────────────
# Preparado para cuando se instale @sentry/nestjs.
# Si no está definido, el filtro de errores loguea a Railway con errorId para correlación.
# Obtener en: https://sentry.io → Settings → Projects → <proyecto> → Client Keys
SENTRY_DSN=
