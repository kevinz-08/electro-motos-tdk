{
  "name": "h2r-store",
  "version": "0.0.0",
  "private": true,
  "description": "H2R Online Store — monorepo (apps/web, apps/api, packages/{domain,database,types}).",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:migrate": "pnpm --filter @h2r/database migrate:dev",
    "db:seed": "pnpm --filter @h2r/database seed",
    "db:studio": "pnpm --filter @h2r/database studio",
    "db:generate": "pnpm --filter @h2r/database generate",
    "db:catalog": "pnpm --filter @h2r/database catalog"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  }
}
