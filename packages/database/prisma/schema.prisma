generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  WOMPI
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

// ─── NextAuth.js required models ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core models ─────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  image               String?
  /// Contraseña hasheada con bcrypt. Null para usuarios OAuth (Google).
  password            String?
  role                Role                 @default(CUSTOMER)
  /// Null mientras el usuario no haya verificado su email. Requerido por PrismaAdapter de NextAuth.
  emailVerified       DateTime?
  createdAt           DateTime             @default(now())
  /// Timestamp de aceptación de T&C + Política de Privacidad. Null = nunca aceptó explícitamente.
  acceptedTermsAt     DateTime?
  /// Versión del documento aceptado. Permite detectar si el usuario debe re-aceptar tras una actualización.
  acceptedTermsVersion String?
  /// Consentimiento para recibir comunicaciones de marketing (separado del consentimiento de T&C — Ley 1581/2012).
  marketingConsent    Boolean              @default(false)
  marketingConsentAt  DateTime?
  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  emailOtps           EmailOtp[]
}

/// Código OTP de 6 dígitos para verificación de email al registrarse.
/// Se almacena el SHA-256 del código, nunca el código en claro.
/// Expira en 10 minutos. Máximo 5 intentos fallidos antes de invalidarse.
model EmailOtp {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 del token crudo enviado por email. Nunca almacenamos el token en claro.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  /// null  → categoría raíz (padre)
  /// non-null → subcategoría; apunta al id del padre
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
}

model Product {
  id                    String                    @id @default(cuid())
  name                  String
  slug                  String                    @unique
  description           String                    @db.Text
  price                 Int                       // centavos COP
  stock                 Int                       @default(0)
  sku                   String                    @unique
  images                String[]
  isActive              Boolean                   @default(true)
  categoryId            String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  category              Category                  @relation(fields: [categoryId], references: [id])
  compatible            MotorcycleCompatibility[]
  orderItems            OrderItem[]
  structuredDescription ProductDescription?
}

model ProductDescription {
  id                 String           @id @default(cuid())
  productId          String           @unique
  generalDescription String?          @db.Text
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  benefits           ProductBenefit[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([productId])
}

model ProductBenefit {
  id            String             @id @default(cuid())
  descriptionId String
  title         String?
  body          String             @db.Text
  order         Int                @default(0)
  description   ProductDescription @relation(fields: [descriptionId], references: [id], onDelete: Cascade)

  @@index([descriptionId, order])
}

model MotorcycleCompatibility {
  id        String  @id @default(cuid())
  productId String
  brand     String
  model     String
  year      Int?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                 String          @id @default(cuid())
  userId             String
  status             OrderStatus     @default(PENDING)
  total              Int             // centavos COP
  shippingAddress    Json
  paymentProvider    PaymentProvider
  /// ID del pedido creado en Vendelo API. Null hasta que VendeloOrderQueueService lo procesa.
  vendeloOrderId     String?
  /// Timestamp del momento exacto en que el usuario marcó el checkbox de políticas en el checkout.
  /// Evidencia inmutable para disputas legales o auditorías de la SIC.
  policiesAcceptedAt DateTime?
  /// Tipo de documento del comprador. Requerido para generar el comprobante de venta
  /// y como identificación válida en el pedido Vendelo (reemplaza el hack del teléfono).
  /// Valores: CC | CE | NIT | PASAPORTE
  buyerIdType        String          @default("CC")
  /// Número del documento del comprador. Texto porque NIT incluye dígito de verificación
  /// (ej. "900123456-7") y CE puede contener letras.
  buyerIdNumber      String          @default("")
  /// Razón social — solo aplica cuando buyerIdType es NIT (compras B2B).
  buyerBusinessName  String?
  createdAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id])
  items              OrderItem[]
  payment            Payment?
  shipment           Shipment?
}

/// Envío asociado a un pedido. Se crea cuando Vendelo dispara el primer webhook
/// del Chatbot Connection (ORDER_SHIPPED, SHIPMENT_STATUS_UPDATED, etc.).
/// Relación 1:1 con Order.
model Shipment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  /// Estado del envío — mapeado desde los eventos del Chatbot Connection de Vendelo.
  /// PENDING | READY | PREPARING | SHIPPED | INCIDENT | DELIVERED | RETURNED | CANCELLED
  status         String   @default("PENDING")
  trackingNumber String?
  carrier        String?
  labelUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  priceAtPurchase Int     // centavos COP — precio al momento de la compra
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
}

model Payment {
  id         String          @id @default(cuid())
  orderId    String          @unique
  provider   PaymentProvider
  externalId String?         // ID de la transacción en Wompi / Mercado Pago
  status     PaymentStatus   @default(PENDING)
  amount     Int             // centavos COP
  createdAt  DateTime        @default(now())
  order      Order           @relation(fields: [orderId], references: [id])
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model EmailQueue {
  id        String   @id @default(cuid())
  to        String
  orderId   String
  attempts  Int      @default(0)
  lastError String?
  /// PENDING | SENT | FAILED
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  nextRetry DateTime @default(now())

  @@index([status, nextRetry])
}

/// Cola de órdenes pendientes de crear en Vendelo API.
/// Se crea una entrada cuando un pago se confirma (APPROVED).
/// VendeloOrderQueueService la procesa cada 2 min con backoff exponencial (5s→30s→120s).
model VendeloOrderQueue {
  id        String   @id @default(cuid())
  orderId   String
  attempts  Int      @default(0)
  lastError String?
  /// PENDING | SENT | FAILED
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  nextRetry DateTime @default(now())

  @@index([status, nextRetry])
}

/// Catálogo de ciudades colombianas con sus códigos Vendelo.
/// Se pobla via POST /admin/vendelo/sync-cities y se cachea 24h en el checkout.
model VendeloCity {
  /// Código DIVIPOLA de 8 dígitos. Ej: "05001000" = Medellín
  code            String @id
  name            String
  /// Código de subdivisión dentro de la ciudad. Ej: "02"
  subdivisionCode String
  countryCode     String @default("CO")

  @@index([name])
}
